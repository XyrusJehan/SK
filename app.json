{
  "expo": {
    "name": "SK Monitoring",
    "slug": "sk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/rizal-logo.png",
    "scheme": "sk",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rizal.sk",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00000000",
        "foregroundImage": "./assets/images/rizal-logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.rizal.sk"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/rizal-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "supabaseUrl": "https://ttsgeniubfkcexitfqsd.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblBGnKu0",
      "router": {},
      "eas": {
        "projectId": "c9b7166d-f556-4be5-9e05-193050e787e7"
      }
    },
    "owner": "iamwhiskeyy"
  }
}
